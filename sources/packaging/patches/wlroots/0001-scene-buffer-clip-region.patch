+void wlr_scene_buffer_set_clip_region(struct wlr_scene_buffer *scene_buffer,
+		const pixman_region32_t *region) {
+	if (!region) {
+		if (!scene_buffer->has_clip_region) {
+			return;
+		}
+		pixman_region32_clear(&scene_buffer->clip_region);
+		scene_buffer->has_clip_region = false;
+	} else {
+		if (scene_buffer->has_clip_region &&
+				pixman_region32_equal(&scene_buffer->clip_region, region)) {
+			return;
+		}
+		pixman_region32_copy(&scene_buffer->clip_region, region);
+		scene_buffer->has_clip_region = true;
+	}
+	scene_node_update(&scene_buffer->node, NULL);
+}
