+static void
+rounded_rectangle_path(cairo_t *cairo, double x, double y,
+		double width, double height, double radius)
+{
+	const double half_pi = 1.5707963267948966;
+	double r = MIN(radius, MIN(width, height) / 2.0);
+
+	if (r <= 0.0) {
+		cairo_rectangle(cairo, x, y, width, height);
+		return;
+	}
+
+	cairo_new_sub_path(cairo);
+	cairo_arc(cairo, x + width - r, y + r, r, -half_pi, 0);
+	cairo_arc(cairo, x + width - r, y + height - r, r, 0, half_pi);
+	cairo_arc(cairo, x + r, y + height - r, r, half_pi, 2 * half_pi);
+	cairo_arc(cairo, x + r, y + r, r, 2 * half_pi, 3 * half_pi);
+	cairo_close_path(cairo);
+}
+
+static void
+draw_rounded_border(cairo_t *cairo, double x, double y,
+		double width, double height, double radius, double border_width)
+{
+	if (border_width <= 0.0 || width <= border_width
+			|| height <= border_width) {
+		return;
+	}
+
+	double inset = border_width / 2.0;
+	rounded_rectangle_path(cairo, x + inset, y + inset,
+		width - border_width, height - border_width,
+		MAX(0.0, radius - inset));
+	cairo_set_line_width(cairo, border_width);
+	cairo_stroke(cairo);
+}
