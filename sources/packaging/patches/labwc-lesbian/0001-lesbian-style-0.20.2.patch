+
+static void
+init_rounded_region(pixman_region32_t *region, const struct wlr_box *box,
+		int radius)
+{
+	pixman_region32_init(region);
+	radius = MIN(radius, MIN(box->width, box->height) / 2);
+	if (radius <= 0) {
+		pixman_region32_union_rect(region, region,
+			box->x, box->y, box->width, box->height);
+		return;
+	}
+
+	pixman_region32_union_rect(region, region,
+		box->x, box->y + radius, box->width, box->height - 2 * radius);
+	for (int row = 0; row < radius; ++row) {
+		double dy = radius - row - 0.5;
+		int inset = ceil(radius - sqrt(radius * radius - dy * dy));
+		int width = MAX(box->width - 2 * inset, 0);
+		pixman_region32_union_rect(region, region,
+			box->x + inset, box->y + row, width, 1);
+		pixman_region32_union_rect(region, region,
+			box->x + inset, box->y + box->height - row - 1, width, 1);
+	}
+}
+
+static void
+apply_buffer_clip(struct wlr_scene_buffer *scene_buffer, int sx, int sy,
+		void *data)
+{
+	struct view_clip_data *clip = data;
+	struct wlr_scene_surface *scene_surface =
+		wlr_scene_surface_try_from_buffer(scene_buffer);
+	if (!clip->rounded_region || !scene_surface
+			|| wlr_surface_get_root_surface(scene_surface->surface)
+				!= clip->root_surface) {
+		wlr_scene_buffer_set_clip_region(scene_buffer, NULL);
+		return;
+	}
+
+	pixman_region32_t local_region;
+	pixman_region32_init(&local_region);
+	pixman_region32_copy(&local_region, clip->rounded_region);
+	pixman_region32_translate(&local_region, -sx, -sy);
+	wlr_scene_buffer_set_clip_region(scene_buffer, &local_region);
+	pixman_region32_fini(&local_region);
+}
+
+static void
+apply_view_effects(void)
+{
+	struct view *view;
+	wl_list_for_each(view, &server.views, link) {
+		if (!view->mapped || !view->scene_tree) {
+			continue;
+		}
+		enum ssd_active_state state = server.active_view == view
+			? SSD_ACTIVE : SSD_INACTIVE;
+		float opacity = rc.theme->window[state].opacity;
+		wlr_scene_node_for_each_buffer(&view->scene_tree->node,
+			apply_buffer_opacity, &opacity);
+
+		pixman_region32_t rounded_region;
+		pixman_region32_t *rounded_region_ptr = NULL;
+		if (view_is_floating(view) && rc.corner_radius > 0 && view->surface) {
+			struct wlr_box extents = ssd_max_extents(view);
+			int tree_x, tree_y;
+			wlr_scene_node_coords(&view->content_tree->node, &tree_x, &tree_y);
+			/*
+			 * for_each_buffer() reports coordinates relative to the parent of
+			 * the root node passed to it, rather than layout coordinates.
+			 */
+			extents.x -= tree_x - view->content_tree->node.x;
+			extents.y -= tree_y - view->content_tree->node.y;
+			init_rounded_region(&rounded_region, &extents, rc.corner_radius);
+			rounded_region_ptr = &rounded_region;
+		}
+		struct view_clip_data clip = {
+			.root_surface = view->surface,
+			.rounded_region = rounded_region_ptr,
+		};
+		wlr_scene_node_for_each_buffer(&view->content_tree->node,
+			apply_buffer_clip, &clip);
+		if (rounded_region_ptr) {
+			pixman_region32_fini(&rounded_region);
+		}
+	}
+}
