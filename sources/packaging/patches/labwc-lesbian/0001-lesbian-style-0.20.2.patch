+
+static void
+set_cairo_color(cairo_t *cairo, const float color[4])
+{
+	double alpha = color[3];
+	cairo_set_source_rgba(cairo,
+		alpha > 0.0 ? color[0] / alpha : 0.0,
+		alpha > 0.0 ? color[1] / alpha : 0.0,
+		alpha > 0.0 ? color[2] / alpha : 0.0,
+		alpha);
+}
+
+static void
+menu_rounded_path(cairo_t *cairo, int width, int height, int radius,
+		bool round_top, bool round_bottom)
+{
+	double r = MIN(radius, MIN(width, height) / 2.0);
+	const double half_pi = acos(-1.0) / 2.0;
+
+	cairo_new_sub_path(cairo);
+	cairo_move_to(cairo, round_top ? r : 0, 0);
+	cairo_line_to(cairo, round_top ? width - r : width, 0);
+	if (round_top) {
+		cairo_arc(cairo, width - r, r, r, -half_pi, 0);
+	}
+	cairo_line_to(cairo, width, round_bottom ? height - r : height);
+	if (round_bottom) {
+		cairo_arc(cairo, width - r, height - r, r, 0, half_pi);
+	}
+	cairo_line_to(cairo, round_bottom ? r : 0, height);
+	if (round_bottom) {
+		cairo_arc(cairo, r, height - r, r, half_pi, 2 * half_pi);
+	}
+	cairo_line_to(cairo, 0, round_top ? r : 0);
+	if (round_top) {
+		cairo_arc(cairo, r, r, r, 2 * half_pi, 3 * half_pi);
+	}
+	cairo_close_path(cairo);
+}
+
+static struct lab_data_buffer *
+menu_background_render(struct scaled_buffer *scaled, double scale)
+{
+	struct menu_background *bg = scaled->data;
+	struct lab_data_buffer *buffer = buffer_create_cairo(
+		bg->width, bg->height, scale);
+	if (!buffer) {
+		return NULL;
+	}
+
+	cairo_t *cairo = cairo_create(buffer->surface);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_CLEAR);
+	cairo_paint(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	set_cairo_color(cairo, bg->color);
+	menu_rounded_path(cairo, bg->width, bg->height, bg->radius,
+		bg->round_top, bg->round_bottom);
+	cairo_fill(cairo);
+
+	if (bg->border_width > 0) {
+		int inset = bg->border_width;
+		int inner_width = bg->width - 2 * inset;
+		int inner_height = bg->height - 2 * inset;
+		if (inner_width > 0 && inner_height > 0) {
+			cairo_set_operator(cairo, CAIRO_OPERATOR_CLEAR);
+			cairo_translate(cairo, inset, inset);
+			menu_rounded_path(cairo, inner_width, inner_height,
+				MAX(bg->radius - inset, 0), true, true);
+			cairo_fill(cairo);
+		}
+	}
+
+	cairo_surface_flush(buffer->surface);
+	cairo_destroy(cairo);
+	return buffer;
+}
+
+static void
+menu_background_destroy(struct scaled_buffer *scaled)
+{
+	free(scaled->data);
+}
+
+static bool
+menu_background_equal(struct scaled_buffer *a, struct scaled_buffer *b)
+{
+	struct menu_background *bg_a = a->data;
+	struct menu_background *bg_b = b->data;
+	return bg_a->width == bg_b->width
+		&& bg_a->height == bg_b->height
+		&& bg_a->radius == bg_b->radius
+		&& bg_a->border_width == bg_b->border_width
+		&& bg_a->round_top == bg_b->round_top
+		&& bg_a->round_bottom == bg_b->round_bottom
+		&& !memcmp(bg_a->color, bg_b->color, sizeof(bg_a->color));
+}
+
+static const struct scaled_buffer_impl menu_background_impl = {
+	.create_buffer = menu_background_render,
+	.destroy = menu_background_destroy,
+	.equal = menu_background_equal,
+};
+
+static bool
+menu_background_accepts_input(struct wlr_scene_buffer *scene_buffer,
+		double *sx, double *sy)
+{
+	struct wlr_buffer *buffer = scene_buffer->buffer;
+	if (!buffer || scene_buffer->dst_width <= 0
+			|| scene_buffer->dst_height <= 0) {
+		return false;
+	}
+
+	int x = floor(*sx * buffer->width / scene_buffer->dst_width);
+	int y = floor(*sy * buffer->height / scene_buffer->dst_height);
+	if (x < 0 || y < 0 || x >= buffer->width || y >= buffer->height) {
+		return false;
+	}
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer,
+			WLR_BUFFER_DATA_PTR_ACCESS_READ, &data, &format, &stride)) {
+		return true;
+	}
+	(void)format;
+	uint8_t alpha = ((uint8_t *)data)[y * stride + x * 4 + 3];
+	wlr_buffer_end_data_ptr_access(buffer);
+	return alpha > 0;
+}
+
+static struct wlr_scene_node *
+menu_background_create(struct wlr_scene_tree *parent, int width, int height,
+		const float color[4], int radius, int border_width,
+		bool round_top, bool round_bottom)
+{
+	struct scaled_buffer *scaled = scaled_buffer_create(
+		parent, &menu_background_impl, true);
+	struct menu_background *bg = znew(*bg);
+	bg->width = width;
+	bg->height = height;
+	bg->radius = radius;
+	bg->border_width = border_width;
+	bg->round_top = round_top;
+	bg->round_bottom = round_bottom;
+	memcpy(bg->color, color, sizeof(bg->color));
+	scaled->data = bg;
+	scaled->scene_buffer->point_accepts_input = menu_background_accepts_input;
+	scaled_buffer_request_update(scaled, width, height);
+	return &scaled->scene_buffer->node;
+}
+
