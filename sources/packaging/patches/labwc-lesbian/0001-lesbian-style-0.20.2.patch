 #include "view.h"
 
+static void
+add_color_stop(cairo_pattern_t *pattern, double offset, const float color[4])
+{
+	double alpha = color[3];
+	double red = alpha > 0.0 ? color[0] / alpha : 0.0;
+	double green = alpha > 0.0 ? color[1] / alpha : 0.0;
+	double blue = alpha > 0.0 ? color[2] / alpha : 0.0;
+	cairo_pattern_add_color_stop_rgba(pattern, offset,
+		red, green, blue, alpha);
+}
+
+static cairo_pattern_t *
+create_border_pattern(int width, int height, float colors[3][4], int count)
+{
+	count = CLAMP(count, 1, 3);
+	if (count == 1) {
+		double alpha = colors[0][3];
+		return cairo_pattern_create_rgba(
+			alpha > 0.0 ? colors[0][0] / alpha : 0.0,
+			alpha > 0.0 ? colors[0][1] / alpha : 0.0,
+			alpha > 0.0 ? colors[0][2] / alpha : 0.0,
+			alpha);
+	}
+
+	cairo_pattern_t *pattern = cairo_pattern_create_linear(0, 0,
+		width, height);
+	for (int i = 0; i < count; i++) {
+		add_color_stop(pattern, (double)i / (double)(count - 1), colors[i]);
+	}
+	return pattern;
+}
+
+static void
+rounded_border_path(cairo_t *cairo, int width, int height,
+		int radius, int line_width, bool rounded)
+{
+	double half = line_width / 2.0;
+	if (!rounded) {
+		cairo_rectangle(cairo, half, half,
+			MAX(width - line_width, 0), MAX(height - line_width, 0));
+		return;
+	}
+
+	double r = MIN(radius, MIN(width, height) / 2.0);
+	double arc_radius = MAX(r - half, 0.0);
+	const double deg = acos(-1.0) / 180.0;
+	cairo_new_sub_path(cairo);
+	cairo_move_to(cairo, r, half);
+	cairo_line_to(cairo, width - r, half);
+	cairo_arc(cairo, width - r, r, arc_radius, -90 * deg, 0 * deg);
+	cairo_line_to(cairo, width - half, height - r);
+	cairo_arc(cairo, width - r, height - r, arc_radius, 0 * deg, 90 * deg);
+	cairo_line_to(cairo, r, height - half);
+	cairo_arc(cairo, r, height - r, arc_radius, 90 * deg, 180 * deg);
+	cairo_line_to(cairo, half, r);
+	cairo_arc(cairo, r, r, arc_radius, 180 * deg, 270 * deg);
+	cairo_close_path(cairo);
+}
+
+static struct lab_data_buffer *
+render_border_part(int part_x, int part_y, int part_width, int part_height,
+		int full_width, int full_height, int radius, int line_width,
+		bool rounded, float colors[3][4], int color_count)
+{
+	struct lab_data_buffer *buffer = buffer_create_cairo(
+		part_width, part_height, 1);
+	assert(buffer);
+	cairo_t *cairo = cairo_create(buffer->surface);
+
+	cairo_set_operator(cairo, CAIRO_OPERATOR_CLEAR);
+	cairo_paint(cairo);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_set_antialias(cairo, CAIRO_ANTIALIAS_BEST);
+	cairo_set_line_width(cairo, line_width);
+	cairo_set_line_cap(cairo, CAIRO_LINE_CAP_BUTT);
+	cairo_set_line_join(cairo, CAIRO_LINE_JOIN_ROUND);
+	cairo_translate(cairo, -part_x, -part_y);
+
+	cairo_pattern_t *pattern = create_border_pattern(
+		full_width, full_height, colors, color_count);
+	cairo_set_source(cairo, pattern);
+	rounded_border_path(cairo, full_width, full_height,
+		radius, line_width, rounded);
+	cairo_stroke(cairo);
+	cairo_pattern_destroy(pattern);
+
+	cairo_surface_flush(buffer->surface);
+	cairo_destroy(cairo);
+	return buffer;
+}
+
+static bool
+border_accepts_input(struct wlr_scene_buffer *scene_buffer,
+		double *sx, double *sy)
+{
+	struct wlr_buffer *buffer = scene_buffer->buffer;
+	int x = floor(*sx);
+	int y = floor(*sy);
+	if (!buffer || x < 0 || y < 0 || x >= buffer->width || y >= buffer->height) {
+		return false;
+	}
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer,
+			WLR_BUFFER_DATA_PTR_ACCESS_READ, &data, &format, &stride)) {
+		return true;
+	}
+	(void)format;
+	uint8_t alpha = ((uint8_t *)data)[y * stride + x * 4 + 3];
+	wlr_buffer_end_data_ptr_access(buffer);
+	return alpha > 0;
+}
+
+static void
+update_border_part(struct wlr_scene_buffer *scene_buffer,
+		int x, int y, int width, int height,
+		int full_width, int full_height, int radius, int line_width,
+		bool rounded, float colors[3][4], int color_count)
+{
+	if (width <= 0 || height <= 0) {
+		wlr_scene_node_set_enabled(&scene_buffer->node, false);
+		return;
+	}
+
+	struct lab_data_buffer *buffer = render_border_part(x, y, width, height,
+		full_width, full_height, radius, line_width,
+		rounded, colors, color_count);
+	wlr_scene_buffer_set_buffer(scene_buffer, &buffer->base);
+	wlr_scene_buffer_set_dest_size(scene_buffer, width, height);
+	wlr_buffer_drop(&buffer->base);
+	wlr_scene_node_set_position(&scene_buffer->node, x, y);
+	wlr_scene_node_set_enabled(&scene_buffer->node, true);
+}
