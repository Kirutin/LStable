+	bool round_top = radius > 0 && item_is_first(item);
+	bool round_bottom = radius > 0 && item_is_last(item);
+
+	if (round_top || round_bottom) {
+		menu_background_create(parent, width, height, color, radius, 0,
+			round_top, round_bottom);
+	} else {
+		lab_wlr_scene_rect_create(parent, width, height, color);
+	}
+}
