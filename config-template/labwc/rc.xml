<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Noctalia-Cyberpunk</name>
    <cornerRadius>14</cornerRadius>
    <font name="Noto Sans" size="10" />
  </theme>

  <keyboard>
    <default />
    <!-- Debian profile ships Kitty as the terminal standard. -->
    <keybind key="W-Return">
      <action name="Execute" command="kitty" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>
</labwc_config>
