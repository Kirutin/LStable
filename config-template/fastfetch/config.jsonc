{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "@@HOME@@/.config/fastfetch/kiru-fastfetch-lesbian-precomp.png",
    "width": 36,
    "height": 25,
    "padding": {
      "left": 4,
      "top": 0,
      "right": 4
    }
  },
  "display": {
    "separator": " ❯ ",
    "pipe": false
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "38;2;238;15;84",
        "at": "38;2;217;168;190",
        "host": "38;2;168;85;247"
      }
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "38;2;238;15;84",
      "format": "Lesbian Stable"
    },
    {
      "type": "os",
      "key": "├{icon}",
      "keyColor": "38;2;220;38;131",
      "format": "Lesbian Trixie {8} {12}"
    },
    {
      "type": "kernel",
      "key": "├",
      "keyColor": "38;2;168;85;247"
    },
    {
      "type": "packages",
      "key": "├󰏖",
      "keyColor": "38;2;238;15;84"
    },
    {
      "type": "shell",
      "key": "├",
      "keyColor": "38;2;220;38;131"
    },
    {
      "type": "command",
      "key": "├󰔚",
      "keyColor": "38;2;245;181;165",
      "text": "b=$(stat -c %W / 2>/dev/null); [ -z \"$b\" ] || [ \"$b\" -le 0 ] && b=$(stat -c %Y /var/log/installer 2>/dev/null || stat -c %Y /); n=$(date +%s); s=$((n-b)); d=$((s/86400)); h=$(((s%86400)/3600)); m=$(((s%3600)/60)); bd=$(date -d \"@$b\" +%d.%m.%Y 2>/dev/null || date -r \"$b\" +%d.%m.%Y); printf '%d Tage, %d Std, %d Min - %s' \"$d\" \"$h\" \"$m\" \"$bd\""
    },
    {
      "type": "uptime",
      "key": "└󰅐",
      "keyColor": "38;2;168;85;247"
    },
    "break",
    {
      "type": "command",
      "key": " DE/WM",
      "keyColor": "38;2;168;85;247",
      "text": "v=$(labwc --version 2>/dev/null | sed -n '1s/^labwc \\([^ ]*\\).*/\\1/p'); printf 'labwc %s (Wayland)' \"${v:-unbekannt}\""
    },
    {
      "type": "lm",
      "key": "├󰧨",
      "keyColor": "38;2;238;15;84"
    },
    {
      "type": "icons",
      "key": "├󰀻",
      "keyColor": "38;2;245;181;165"
    },
    {
      "type": "terminal",
      "key": "├",
      "keyColor": "38;2;238;15;84"
    },
    "break",
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "38;2;220;38;131"
    },
    {
      "type": "cpu",
      "key": "├󰻠",
      "keyColor": "38;2;168;85;247"
    },
    {
      "type": "gpu",
      "key": "├󰍛",
      "keyColor": "38;2;238;15;84"
    },
    {
      "type": "disk",
      "key": "├",
      "keyColor": "38;2;220;38;131"
    },
    {
      "type": "memory",
      "key": "├󰑭",
      "keyColor": "38;2;168;85;247"
    },
    {
      "type": "swap",
      "key": "├󰓡",
      "keyColor": "38;2;238;15;84"
    },
    {
      "type": "display",
      "key": "└󰍹",
      "keyColor": "38;2;220;38;131"
    },
    "break",
    {
      "type": "sound",
      "key": " SOUND",
      "keyColor": "38;2;238;15;84"
    },
    {
      "type": "player",
      "key": "├󰥠",
      "keyColor": "38;2;245;181;165"
    },
    {
      "type": "media",
      "key": "└󰝚",
      "keyColor": "38;2;168;85;247"
    }
  ]
}
